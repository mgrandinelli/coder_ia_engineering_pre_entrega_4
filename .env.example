# Plantilla de variables de entorno: copiar como .env y completar las claves. El .env no se sube al repo.

PINECONE_API_KEY=
OPENAI_API_KEY=
INDEX_NAME=atlas-docs

# Opcionales
PINECONE_NAMESPACE=documentacion
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings: openai (text-embedding-3-small, 1536 dimensiones) o local (384 dimensiones, sin clave).
# Vacío: openai si hay OPENAI_API_KEY, local en caso contrario.
EMBEDDINGS_PROVIDER=
